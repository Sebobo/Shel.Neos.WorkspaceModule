##
# The views of the review.
#
# The fusion view resolves the prototype by controller and action, so every action of the
# review needs one here. The variables assigned by the action are passed to the component as
# props, because a component does not see the variables of the view on its own.
#
# The answers of the actions that change something carry the list of documents as well, so that
# it is refreshed together with the changes and can mark the document that is open.
#
Shel.Neos.WorkspaceModule.WorkspacesController {
    show = Neos.Fusion:Component {
        contentDimensions = ${contentDimensions}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        selectedWorkspaceLabel = ${selectedWorkspaceLabel}
        baseWorkspaceLabel = ${baseWorkspaceLabel}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        flashMessages = ${flashMessages}

        renderer = Shel.Neos.WorkspaceModule:Component.Review {
            contentDimensions = ${contentDimensions}
            selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
            selectedWorkspaceLabel = ${selectedWorkspaceLabel}
            baseWorkspaceLabel = ${baseWorkspaceLabel}
            canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
            flashMessages = ${flashMessages}
        }
    }

    documentTree = Neos.Fusion:Component {
        sites = ${sites}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        selectedDocument = ${selectedDocument}
        autoLoad = ${autoLoad}

        renderer = Shel.Neos.WorkspaceModule:Component.DocumentTree {
            sites = ${sites}
            selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
            selectedDocument = ${selectedDocument}
            autoLoad = ${autoLoad}
        }
    }

    documentChanges = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
            renderer = afx`
                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }

    publishChange = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
            renderer = afx`
                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }

    discardChange = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
            renderer = afx`
                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }

    publishSelected = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
            renderer = afx`
                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }

    discardSelected = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
            renderer = afx`
                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }

    publishDocument = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
            renderer = afx`
                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }

    discardDocument = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
            renderer = afx`
                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }
    publishAll = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
            renderer = afx`
                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }

    discardAll = Neos.Fusion:Component {
        changes = ${changes}
        sites = ${sites}
        selectedDocument = ${selectedDocument}
        selectedWorkspaceName = ${selectedWorkspaceName}
        selectedDimensions = ${selectedDimensions}
        canPublishToBaseWorkspace = ${canPublishToBaseWorkspace}
        documentLabel = ${documentLabel}
        documentIcon = ${documentIcon}
        documentDimensionLabel = ${documentDimensionLabel}
        documentBreadcrumb = ${documentBreadcrumb}

        renderer = Neos.Fusion:Component {
