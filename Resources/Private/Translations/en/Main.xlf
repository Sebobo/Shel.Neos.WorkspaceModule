<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file original="" product="Shel.Neos.WorkspaceModule" source-language="en" datatype="plaintext">
        <body>
            <trans-unit id="module.loadingText">
                <source>Loading workspace module…</source>
            </trans-unit>

            <trans-unit id="table.column.access.private">
                <source>This workspace is owned by {owner}</source>
            </trans-unit>
            <trans-unit id="table.column.access.internal">
                <source>This is a shared workspace</source>
            </trans-unit>
            <trans-unit id="table.column.access.acl">
                <source>This workspace is owned by {owner} but allows access to additional users</source>
            </trans-unit>
            <trans-unit id="table.header.title">
                <source>Title</source>
            </trans-unit>
            <trans-unit id="table.header.lastModified">
                <source>Last modified</source>
            </trans-unit>
            <trans-unit id="table.header.changes">
                <source>Changes</source>
            </trans-unit>
            <trans-unit id="table.header.actions">
                <source>Actions</source>
            </trans-unit>
            <trans-unit id="table.header.creator">
                <source>Creator</source>
            </trans-unit>
            <trans-unit id="table.header.description">
                <source>Description</source>
            </trans-unit>

            <trans-unit id="table.column.changes.empty">
                <source>None</source>
            </trans-unit>
            <trans-unit id="table.column.action.show">
                <source>Review</source>
            </trans-unit>
            <trans-unit id="table.column.action.show.title">
                <source>Show changes in workspace "{workspace}"</source>
            </trans-unit>
            <trans-unit id="table.column.action.show.disabled.title">
                <source>No changes to review</source>
            </trans-unit>
            <trans-unit id="table.column.action.edit">
                <source>Edit workspace "{workspace}"</source>
            </trans-unit>
            <trans-unit id="table.column.action.delete">
                <source>Delete workspace "{workspace}"</source>
            </trans-unit>

            <trans-unit id="footer.action.create">
                <source>Create new workspace</source>
            </trans-unit>
            <trans-unit id="footer.workspaceCount">
                <source>{total} workspaces ({internal} public, {private} private)</source>
            </trans-unit>

            <trans-unit id="badge.isStale">
                <source>Workspace is stale!</source>
            </trans-unit>
            <trans-unit id="badge.isUserWorkspace">
                <source>(This is your workspace)</source>
            </trans-unit>
            <trans-unit id="badge.changes.new">
                <source>{count} new content items were added</source>
            </trans-unit>
            <trans-unit id="badge.changes.changed">
                <source>{count} content items were changed</source>
            </trans-unit>
            <trans-unit id="badge.changes.removed">
                <source>{count} content items were removed</source>
            </trans-unit>
            <trans-unit id="badge.changes.unknown">
                <source>{count} content items were changed but might be orphaned</source>
            </trans-unit>
            <trans-unit id="badge.staleWorkspaceOfCurrentUser">
                <source>This workspace is stale and owned by you, consider deleting it.</source>
            </trans-unit>

            <trans-unit id="dialog.action.cancel">
                <source>Cancel</source>
            </trans-unit>
            <trans-unit id="dialog.action.create">
                <source>Create workspace</source>
            </trans-unit>
            <trans-unit id="dialog.action.delete">
                <source>Delete workspace "{workspace}"</source>
            </trans-unit>
            <trans-unit id="dialog.action.update">
                <source>Save changes</source>
            </trans-unit>

            <trans-unit id="dialog.create.header">
                <source>Create new workspace</source>
            </trans-unit>

            <trans-unit id="dialog.edit.header">
                <source>Edit workspace "{workspace}"</source>
            </trans-unit>

            <trans-unit id="dialog.delete.header">
                <source>Delete workspace "{workspace}"?</source>
            </trans-unit>
            <trans-unit id="dialog.delete.pointOfNoReturn">
                <source>This action cannot be undone.</source>
            </trans-unit>
            <trans-unit id="dialog.delete.rebasedWorkspaces">
                <source><![CDATA[The following workspaces will be rebased onto the <strong>live</strong> workspace:]]></source>
            </trans-unit>
            <trans-unit id="dialog.delete.privateWorkspaces">
                <source><![CDATA[<strong>{count}</strong> private workspace(s)]]></source>
            </trans-unit>
            <trans-unit id="dialog.delete.unpublishedChanges">
                <source><![CDATA[Deleting this workspace will also discard <strong>{count}</strong> unpublished changes.]]></source>
            </trans-unit>

            <trans-unit id="dialog.prune.header">
                <source>Prune workspace "{workspace}"?</source>
            </trans-unit>
            <trans-unit id="dialog.prune.pointOfNoReturn">
                <source>This action cannot be undone.</source>
            </trans-unit>
            <trans-unit id="dialog.prune.unpublishedChanges">
                <source><![CDATA[Pruning this workspace will discard <strong>{count}</strong> changes.]]></source>
            </trans-unit>

            <trans-unit id="workspace.title.label">
                <source>Title</source>
            </trans-unit>
            <trans-unit id="workspace.title.validation">
                <source><![CDATA[
                    <b>Allowed title pattern: </b>
                    <ul>
                        <li>Numbers</li>
                        <li>Letters (upper &amp; lowercase)</li>
                        <li>Special characters: - _ [ ] . ( )</li>
                        <li>First character needs to be an uppercase letter</li>
                        <li>No trailing whitespace</li>
                    </ul>]]>
                </source>
            </trans-unit>
            <trans-unit id="workspace.description.label">
                <source>Description</source>
            </trans-unit>
            <trans-unit id="workspace.baseWorkspace.label">
                <source>Base workspace</source>
            </trans-unit>
            <trans-unit id="workspace.owner.label">
                <source>Owner</source>
            </trans-unit>
            <trans-unit id="workspace.acl.label">
                <source>Allow access for additional users:</source>
            </trans-unit>
            <trans-unit id="workspace.acl.filter.placeholder">
                <source>Filter by name</source>
            </trans-unit>
            <trans-unit id="workspace.acl.filter.empty">
                <source>No users found</source>
            </trans-unit>
            <trans-unit id="workspace.visibility.label">
                <source>Visibility</source>
            </trans-unit>
            <trans-unit id="workspace.visibility.internal">
                <source>Public – Any logged in editor can see and modify this workspace.</source>
            </trans-unit>
            <trans-unit id="workspace.visibility.internal.info">
                <source>Any logged in editor can see and modify this workspace.</source>
            </trans-unit>
            <trans-unit id="workspace.visibility.private">
                <source>Private – Only reviewers and administrators can access and modify this workspace.</source>
            </trans-unit>
            <trans-unit id="workspace.visibility.private.info">
                <source>Only reviewers and administrators can access and modify this workspace.</source>
            </trans-unit>
            <trans-unit id="workspace.visibility.isPersonal">
                <source>This is a personal workspace and only the owner can access and modify this workspace.</source>
            </trans-unit>

            <trans-unit id="message.workspaceUpdated">
                <source>The workspace "{workspaceName}" has been updated.</source>
            </trans-unit>
            <trans-unit id="message.workspaceCreated">
                <source>The workspace "{workspaceName}" has been created.</source>
            </trans-unit>
            <trans-unit id="message.workspaceRemoved">
                <source>The workspace "{workspaceName}" has been removed, {unpublishedNodes} changes have been discarded and {dependentWorkspaces} dependent workspaces have been rebased.</source>
            </trans-unit>
            <trans-unit id="message.workspacePruned">
                <source>The workspace "{workspaceName}" has been pruned, {contentCount} changes have been discarded.</source>
            </trans-unit>
            <trans-unit id="message.workspaceIsPersonal">
                <source>The workspace "{workspaceName}" is personal and cannot be deleted.</source>
            </trans-unit>
            <trans-unit id="message.workspaceRebased">
                <source>Workspace "{dependentWorkspaceName}" has been rebased to "live" as it depends on workspace "{workspaceName}".</source>
            </trans-unit>
            <trans-unit id="message.workspaceEmpty">
                <source>There are no unpublished changes in workspace "{workspaceName}".</source>
            </trans-unit>

            <trans-unit id="error.invalidWorkspaceChain">
                <source>The base workspaces of "{workspaceName}" cannot be resolved.</source>
            </trans-unit>
            <trans-unit id="error.workspaceInaccessible">
                <source>You are not permitted to access the workspace "{workspaceName}".</source>
            </trans-unit>
            <trans-unit id="error.pruneFailed">
                <source>The workspace "{workspaceName}" could not be pruned.</source>
            </trans-unit>

            <trans-unit id="nagging.staleWorkspacesWarning">
                <source>You own {0} stale workspaces. Please consider deleting them.</source>
            </trans-unit>

            <!-- Review view: legend of a change, and the node state as a change of its own -->
            <trans-unit id="review.nodeState.hidden">
                <source>hidden</source>
            </trans-unit>
            <trans-unit id="review.nodeState.hiddenInIndex">
                <source>hidden in index</source>
            </trans-unit>
            <trans-unit id="review.nodeState.hiddenBeforeDateTime">
                <source>hidden before</source>
            </trans-unit>
            <trans-unit id="review.nodeState.hiddenAfterDateTime">
                <source>hidden after</source>
            </trans-unit>
            <trans-unit id="review.nodeDeleted">
                <source>This content has been deleted.</source>
            </trans-unit>
            <trans-unit id="review.noRenderableChanges">
                <source>No changes that can be displayed</source>
            </trans-unit>
            <trans-unit id="review.noChangesAtAll">
                <source>This content has no differences to the published version, only metadata such as the modification time changed.</source>
            </trans-unit>
            <trans-unit id="review.value.true">
                <source>Yes</source>
            </trans-unit>
            <trans-unit id="review.value.false">
                <source>No</source>
            </trans-unit>
            <trans-unit id="review.publishDocument">
                <source>Publish current document</source>
            </trans-unit>
            <trans-unit id="review.discardDocument">
                <source>Discard document</source>
            </trans-unit>
            <trans-unit id="review.documentPublished">
                <source>The changes of the document have been published</source>
            </trans-unit>
            <trans-unit id="review.documentDiscarded">
                <source>The changes of the document have been discarded</source>
            </trans-unit>
            <trans-unit id="review.publishAll.confirmTitle">
                <source>Publish all changes?</source>
            </trans-unit>
            <trans-unit id="review.publishAll.confirmText">
                <source>All changes of the workspace "{0}" are published into its base workspace.</source>
            </trans-unit>
            <trans-unit id="review.discardAll.confirmTitle">
                <source>Discard all changes?</source>
            </trans-unit>
            <trans-unit id="review.discardAll.confirmText">
                <source>All changes of the workspace "{0}" are discarded. This cannot be undone.</source>
            </trans-unit>
            <trans-unit id="review.confirm">
                <source>Confirm</source>
            </trans-unit>
            <trans-unit id="review.cancel">
                <source>Cancel</source>
            </trans-unit>
            <trans-unit id="review.reload">
                <source>Reload</source>
            </trans-unit>
            <trans-unit id="review.backToWorkspaces">
                <source>Back to the workspaces</source>
            </trans-unit>
            <trans-unit id="review.preview">
                <source>Preview the document</source>
            </trans-unit>

            <trans-unit id="review.syncScroll">
                <source>Synchronise the scroll positions</source>
            </trans-unit>

            <trans-unit id="review.close">
                <source>Close</source>
            </trans-unit>

            <trans-unit id="review.openInContentModule">
                <source>Open the page in the content module</source>
            </trans-unit>
            <trans-unit id="review.documents">
                <source>Documents</source>
            </trans-unit>
            <trans-unit id="review.dimension.all">
                <source>All variants</source>
            </trans-unit>
            <trans-unit id="review.value.notSet">
                <source>Not set</source>
            </trans-unit>
            <trans-unit id="review.value.empty">
                <source>Empty</source>
            </trans-unit>
            <trans-unit id="review.unpublishedChanges">
                <source>Unpublished changes in the workspace "{0}"</source>
            </trans-unit>

            <trans-unit id="review.noDocuments">
                <source>No documents with changes</source>
            </trans-unit>

            <trans-unit id="review.noChanges">
                <source>This document has no changes</source>
            </trans-unit>

            <!-- The number of the changes of a document, for the hint of the document. -->
            <group restype="x-gettext-plurals">
                <trans-unit id="review.hintChanges[0]">
                    <source><![CDATA[<strong>{0}</strong> change]]></source>
                </trans-unit>
                <trans-unit id="review.hintChanges[1]">
                    <source><![CDATA[<strong>{0}</strong> changes]]></source>
                </trans-unit>
            </group>

            <trans-unit id="review.hintNew">
                <source>{0} new</source>
            </trans-unit>

            <trans-unit id="review.hintChanged">
                <source>{0} changed</source>
            </trans-unit>

            <trans-unit id="review.hintRemoved">
                <source>{0} deleted</source>
            </trans-unit>

            <trans-unit id="review.selectionNone">
                <source>No changes selected</source>
            </trans-unit>

            <trans-unit id="review.selectionAll">
                <source>All changes selected</source>
            </trans-unit>

            <trans-unit id="review.selectionSome">
                <source>{0} of {1} changes selected</source>
            </trans-unit>

            <trans-unit id="review.selectChange">
                <source>Select this change</source>
            </trans-unit>

            <trans-unit id="review.publishChange">
                <source>Publish this change</source>
            </trans-unit>

            <trans-unit id="review.discardChange">
                <source>Discard this change</source>
            </trans-unit>

            <!-- The number of the changes is part of the label, so the label needs a form
                 for one change and one for more. -->
            <group restype="x-gettext-plurals">
                <trans-unit id="review.publishSelected[0]">
                    <source>Publish <![CDATA[<strong>{0}</strong>]]> change</source>
                </trans-unit>
                <trans-unit id="review.publishSelected[1]">
                    <source>Publish <![CDATA[<strong>{0}</strong>]]> changes</source>
                </trans-unit>
            </group>

            <group restype="x-gettext-plurals">
                <trans-unit id="review.discardSelected[0]">
                    <source>Discard <![CDATA[<strong>{0}</strong>]]> change</source>
                </trans-unit>
                <trans-unit id="review.discardSelected[1]">
                    <source>Discard <![CDATA[<strong>{0}</strong>]]> changes</source>
                </trans-unit>
            </group>

            <trans-unit id="review.publishAll">
                <source>Publish all changes in workspace</source>
            </trans-unit>

            <trans-unit id="review.discardAll">
                <source>Discard all changes in workspace</source>
            </trans-unit>

            <trans-unit id="review.showOptions">
                <source>Show the other options</source>
            </trans-unit>

            <trans-unit id="review.changeType.created">
                <source>created</source>
            </trans-unit>

            <trans-unit id="review.changeType.changed">
                <source>changed</source>
            </trans-unit>

            <trans-unit id="review.changeType.moved">
                <source>moved</source>
            </trans-unit>

            <trans-unit id="review.changeType.hidden">
                <source>hidden</source>
            </trans-unit>

            <trans-unit id="review.changeType.deleted">
                <source>deleted</source>
            </trans-unit>

            <trans-unit id="review.changePublished">
                <source>The change has been published</source>
            </trans-unit>

            <trans-unit id="review.changeDiscarded">
                <source>The change has been discarded</source>
            </trans-unit>

            <trans-unit id="review.changesPublished">
                <source>The selected changes have been published</source>
            </trans-unit>

            <trans-unit id="review.changesDiscarded">
                <source>The selected changes have been discarded</source>
            </trans-unit>

            <trans-unit id="review.allChangesPublished">
                <source>All changes of the workspace have been published</source>
            </trans-unit>

            <trans-unit id="review.allChangesDiscarded">
                <source>All changes of the workspace have been discarded</source>
            </trans-unit>

            <trans-unit id="review.noSite">
                <source>no site</source>
            </trans-unit>

        </body>
    </file>
</xliff>
