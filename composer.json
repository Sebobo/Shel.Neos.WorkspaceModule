{
    "name": "shel/neos-workspace-module",
    "description": "An alternative workspace module with additional features for Neos CMS",
    "type": "neos-plugin",
    "license": "MIT",
    "keywords": [
        "flow",
        "neoscms",
        "workspaces"
    ],
    "require": {
        "php": ">=8.4",
        "neos/neos": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "codestyle": "phpstan analyse -c phpstan.neon",
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "Shel\\Neos\\WorkspaceModule\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shel\\Neos\\WorkspaceModule\\Tests\\": "Tests"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Shel.Neos.WorkspaceModule"
        }
    },
    "archive": {
        "exclude": [
            "/.yarn",
            "/.github",
            "/Tests"
        ]
    }
}
