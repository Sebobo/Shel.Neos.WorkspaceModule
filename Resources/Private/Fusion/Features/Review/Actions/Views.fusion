                <Shel.Neos.WorkspaceModule:Component.DocumentTree
                    sites={sites}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    selectedDocument={selectedDocument}
                    outOfBand={true}
                />
                <Shel.Neos.WorkspaceModule:Component.ChangeList
                    changes={changes}
                    documentLabel={documentLabel}
                    documentIcon={documentIcon}
                    documentDimensionLabel={documentDimensionLabel}
                    documentIdentifier={selectedDocument}
                    documentBreadcrumb={documentBreadcrumb}
                    documentIsNew={documentIsNew}
                    documentIsDeleted={documentIsDeleted}
                    documentBaseContextPath={documentBaseContextPath}
                    selectedWorkspaceName={selectedWorkspaceName}
                    selectedDimensions={selectedDimensions}
                    canPublishToBaseWorkspace={canPublishToBaseWorkspace}
                />
            `
        }
    }
}
