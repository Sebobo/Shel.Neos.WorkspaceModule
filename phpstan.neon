parameters:
    level: 8
    phpVersion: 80300
    paths:
        - Classes
    ignoreErrors:
        # The magic methods of the Flow repositories - they exist, but the doctrine
        # annotations of the package are not read.
        - '#Call to an undefined method [a-zA-Z0-9\\_]+Repository::findOneBy[a-zA-Z]+\(\)#'
        # The access control list of a workspace is a collection of the doctrine, but the
        # property also holds an array. The flow reads the type of the property at runtime,
        # where a union with a generic is not understood - so the type of the collection is
        # the one of the doctrine and phpstan is told to live with the missing key type.
        -
            message: '#\$acl#'
            path: Classes/Domain/Model/WorkspaceDetails.php
